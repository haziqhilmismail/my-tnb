:80 {
	# Names this page answers to. Any other Host header (a DNS rebinding page, for example) gets 421.
	@unknown_host not host {$SITE_HOSTS:localhost}
	respond @unknown_host 421
	root * /srv
	# Always check for a newer page: without this, phones kept showing the old one after an update
	header Cache-Control "no-cache"
	reverse_proxy /api/* notes:8000
	file_server
}
